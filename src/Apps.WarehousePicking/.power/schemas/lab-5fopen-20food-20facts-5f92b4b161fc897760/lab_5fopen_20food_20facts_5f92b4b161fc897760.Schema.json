        "title": "Open Food Facts",
        "description": "Look up product data by barcode from the Open Food Facts public database.",
        "version": "1.0"
      },
      "host": "131b3182157ce1978513ad533916a2.0e.environment.api.powerplatform.com",
      "basePath": "/connectors/runtime/invoke/scalegroups/usa002/shards/10/apis/lab-5fopen-20food-20facts-5f92b4b161fc897760/connections/",
      "schemes": [
        "https"
      ],
      "consumes": [],
      "produces": [],
      "paths": {
        "/{connectionId}/product/{barcode}.json": {
          "get": {
            "operationId": "GetProductByBarcode",
            "summary": "Get product by barcode",
            "description": "Returns the product name, brand, quantity and image URL for a barcode.",
            "produces": [
              "application/json"
            ],
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "barcode",
                "in": "path",
                "required": true,
                "type": "string",
                "x-ms-summary": "Barcode",
                "description": "The product barcode (EAN)."
              }
            ],
            "responses": {
              "200": {
                "description": "The product.",
                "schema": {
                  "$ref": "#/definitions/Product"
                }
              }
            }
          }
        },
        "/{connectionId}/product-image": {
          "get": {
            "operationId": "GetProductImage",
            "summary": "Get product image",
            "description": "Returns the bytes of a product image.",
            "produces": [
              "image/jpeg",
              "image/png"
            ],
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "imageUrl",
                "in": "query",
                "required": true,
                "type": "string",
                "x-ms-summary": "Image URL",
                "description": "The URL of the image to fetch."
              }
            ],
            "responses": {
              "200": {
                "description": "The image.",
                "schema": {
                  "type": "file"
                },
                "x-ms-media-kind": "image"
              }
            }
          }
        }
      },
      "definitions": {
        "Product": {
          "type": "object",
          "properties": {
            "ean": {
              "type": "string",
              "description": "Barcode"
            },
            "name": {
              "type": "string",
              "description": "Product name"
            },
            "brand": {
              "type": "string",
              "description": "Brand"
            },
            "quantity": {
              "type": "string",
              "description": "Quantity, as free text"
            },
            "imageUrl": {
              "type": "string",
              "description": "Front image URL"
            }
          }
        }
